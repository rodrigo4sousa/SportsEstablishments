' plantuml-version: 1.2026.8
@startuml 02-containers-prod
!include <C4/C4_Container>

title Contentores · produção, planeado (T06)

LAYOUT_TOP_DOWN()
HIDE_STEREOTYPE()
AddElementTag("planeado", $borderStyle=DashedLine(), $legendText="planeado (T06)")

Container_Ext(C_BROWSER, "C-BROWSER · Browser do utilizador", "Browser", "Vê uma só origem; guarda os cookies httpOnly de sessão.")

Boundary(PL_RENDER, "PL-RENDER · Render", "", "planeado") {
  Boundary(PL_RENDER_WEB, "PL-RENDER-WEB · Serviço web público", "", "planeado") {
    Container(C_WEB, "C-WEB · Aplicação Next.js", "Next.js 16, Node.js", "Única entrada pública, com HTTPS; reencaminha /api/* para a API.", $tags="planeado")
  }
  Boundary(PL_RENDER_API, "PL-RENDER-API · Serviço privado, sem URL público", "", "planeado") {
    Container(C_API, "C-API · API ASP.NET Core", ".NET 10, controllers", "Regras de negócio, cookies, base de dados.", $tags="planeado")
    Container(C_WORKER, "C-WORKER · Worker de emails", "BackgroundService", "Envia os emails do outbox.", $tags="planeado")
  }
}

Boundary(PL_SUPABASE, "PL-SUPABASE · Supabase", "", "planeado") {
  ContainerDb(C_DB, "C-DB · Base de dados", "PostgreSQL gerido", "Todos os dados e as chaves do Data Protection.", $tags="planeado")
}

System_Ext(PL_BREVO, "PL-BREVO · Brevo", "Servidor SMTP de produção", $tags="planeado")

Rel(C_BROWSER, C_WEB, "Abre páginas e chama /api/*", "HTTPS, cookies")
Rel(C_WEB, C_API, "Reencaminha /api/* e lê a API nos Server Components", "HTTP, rede interna do Render")
Rel(C_API, C_DB, "Lê e escreve", "SQL, Npgsql")
Rel(C_WORKER, C_DB, "Lê o outbox e marca o resultado", "SQL")
Rel(C_WORKER, PL_BREVO, "Envia o email", "SMTP, porta 587, StartTls")

SHOW_LEGEND()
@enduml
