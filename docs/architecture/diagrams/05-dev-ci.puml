' plantuml-version: 1.2026.8
@startuml 05-dev-ci
title Vista de desenvolvimento · pipeline de CI (.github/workflows/ci.yml)

skinparam shadowing false
skinparam activity {
  BackgroundColor White
  BorderColor #1168BD
}
skinparam ArrowColor #555555
skinparam partition {
  BorderColor #888888
  BackgroundColor transparent
}

start
:push ou pull_request\nX-GH → X-GHA\nconcurrency: cancela a execução anterior da mesma ref;\npermissions: contents read;
fork
  partition "DEV-CI-BACKEND · Backend (build + tests) · ubuntu-latest · wd backend" {
    :checkout;
    :Instalar o SDK .NET\ndotnet-install.sh ~-~-jsonfile global.json\n(builds.dotnet.microsoft.com, versão exata);
    note right
      Não se usa actions/setup-dotnet: os downloads passam
      por aka.ms para dotnetorigin.blob.core.windows.net,
      que responde 409 (actions/setup-dotnet#794).
      Uma versão exata evita a pesquisa no aka.ms.
    end note
    :dotnet tool restore (dotnet-ef);
    :dotnet restore;
    :dotnet build -c Release ~-~-no-restore\navisos são erros; regenera o openapi/;
    :dotnet test -c Release ~-~-no-build\nunitários + integração com Testcontainers (PostgreSQL);
    :git diff ~-~-exit-code -- src/SportsBooking.Api/openapi\n(OpenAPI atualizado);
    :dotnet ef migrations has-pending-model-changes\n(modelo EF sem migração em falta);
    :dotnet package list ~-~-vulnerable ~-~-include-transitive\nfalha se houver "vulnerabilities";
  }
fork again
  partition "DEV-CI-FRONTEND · Frontend (lint, typecheck, tests, build) · ubuntu-latest · wd frontend" {
    :checkout;
    :setup-node (node 22, cache npm);
    :npm ci;
    :npm run lint;
    :npm run typecheck\nnext typegen && tsc ~-~-noEmit;
    :npm test (Vitest);
    :npm run build;
    :npm run gen:api\ngit diff ~-~-exit-code -- src/lib/api\n(tipos em dia com o OpenAPI);
    :npm audit ~-~-omit=dev ~-~-audit-level=high;
  }
fork again
  partition "DEV-CI-DIAGRAMS · Docs (architecture diagrams) · ubuntu-latest" {
    :checkout;
    :scripts/render-diagrams.sh\nimagem plantuml/plantuml:<versão do cabeçalho dos .puml>;
    :git status ~-~-porcelain -- docs/architecture/diagrams\nvazio = SVG em dia (apanha também um .svg nunca commitado);
  }
end fork
:Os três jobs são independentes (sem needs:);
stop

@enduml
