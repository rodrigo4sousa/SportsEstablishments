' plantuml-version: 1.2026.8
@startuml 04-process-owner-deactivation
!include <C4/C4_Sequence>

title Desativar um dono (US29) · atualização condicional, registo de auditoria e revogação numa transação

HIDE_STEREOTYPE()

Component(WEB_F_ADMIN, "WEB-F-ADMIN · Página do dono", "OwnerStatusForm, changeOwnerStatus")
Container_Boundary(C_API, "C-API · API ASP.NET Core")
  Component(CC_AUTHZ, "CC-AUTHZ · Autorização", "política Admin, ICurrentUser")
  Component(API_ADMIN, "API-ADMIN · Administração", "AdminOwnerStatusService, AdminOwnersService, OwnerStatusStore.TryChangeAsync")
Boundary_End()
ComponentDb(DB_USERS, "DB-USERS · users", "Tabela")
ComponentDb(DB_STATUSCHG, "DB-STATUSCHG · owner_status_changes", "Tabela, só de acrescentar (DB-AUDITTRG)")
ComponentDb(DB_REFRESH, "DB-REFRESH · refresh_tokens", "Tabela")

Rel(WEB_F_ADMIN, CC_AUTHZ, "POST /api/admin/owners/{id}/deactivate { reason }", "apiJson")
Rel(CC_AUTHZ, API_ADMIN, "Sessão Admin (senão 401 ou 403) → DeactivateAsync")
Rel(API_ADMIN, DB_USERS, "AdminOwnersService.GetAsync: um dono? (404 owner_not_found, também para jogador ou admin), antes do corpo", "SELECT")
Rel(API_ADMIN, API_ADMIN, "Valida reason: obrigatório, aparado, ≤ 500 (400)")
Rel(API_ADMIN, CC_AUTHZ, "adminId = ICurrentUser.UserId (da sessão, nunca do pedido)")
group Transação (TryChangeAsync)
  Rel(API_ADMIN, DB_USERS, "UPDATE users SET deactivated_at = now WHERE id = … AND deactivated_at IS NULL", "ExecuteUpdate")
  alt 0 linhas (já desativado, ou outro admin ganhou)
    Rel(API_ADMIN, DB_USERS, "ROLLBACK", "SQL")
    Rel_Back(WEB_F_ADMIN, API_ADMIN, "422 owner_already_deactivated")
  else 1 linha
    Rel(API_ADMIN, DB_STATUSCHG, "OwnerStatusChange.Record(ownerId, Deactivated, reason, adminId, now)", "INSERT")
    Rel(API_ADMIN, DB_REFRESH, "Revoga todos os refresh tokens do dono", "UPDATE … SET revoked_at WHERE user_id = … AND revoked_at IS NULL")
    Rel(API_ADMIN, DB_USERS, "COMMIT", "SQL")
    Rel(API_ADMIN, DB_USERS, "GetAsync outra vez (futureBookings: reservas que continuam confirmadas)", "SELECT")
    Rel_Back(WEB_F_ADMIN, API_ADMIN, "200 AdminOwnerDetailResponse")
    Rel(WEB_F_ADMIN, WEB_F_ADMIN, "invalidateQueries(['admin'])")
  end
end
note over WEB_F_ADMIN, DB_REFRESH: Nenhuma reserva é cancelada. O access token já emitido vale até 15 min (aceite).\nDepois: login, refresh, páginas públicas e novas reservas recusam pelas verificações de deactivated_at.

SHOW_LEGEND()
@enduml
