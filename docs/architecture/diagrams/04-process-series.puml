' plantuml-version: 1.2026.8
@startuml 04-process-series
!include <C4/C4_Sequence>

title Série semanal (US20) · uma transação por data, sucesso parcial e o resumo no fim

HIDE_STEREOTYPE()

Component(WEB_F_BOOKING, "WEB-F-BOOKING · Reservar", "ClubBooking, createRecurring")
Container_Boundary(C_API, "C-API · API ASP.NET Core")
  Component(API_BOOK_SERIES, "API-BOOK-SERIES · Série semanal", "RecurringBookingService.CreateAsync")
  Component(API_AUTH_ACCOUNTS, "API-AUTH-ACCOUNTS · Contas", "IAccountStore.IsActiveAsync")
  Component(CC_LOCK, "CC-LOCK · Trinco do campo", "IPitchLock, PitchLock")
  Component(CC_SLOTCHECK, "CC-SLOTCHECK · Verificação do slot", "BookingSlotCheck.CheckAsync")
  Component(API_NOTIF_OUTBOX, "API-NOTIF-OUTBOX · Pôr no outbox", "BookingEmailOutbox")
  Component(API_BOOK_STORE, "API-BOOK-STORE · Store das reservas", "BookingStore.TryAddAsync")
Boundary_End()
ContainerDb(C_DB, "C-DB · PostgreSQL", "pitches, blocks, bookings, outbox_messages")

Rel(WEB_F_BOOKING, API_BOOK_SERIES, "POST /api/bookings/recurring { pitchId, startsAt, weeks }", "apiJson; política Player")
Rel(API_BOOK_SERIES, API_BOOK_SERIES, "Valida (400; weeks de 1 a 4)")
Rel(API_BOOK_SERIES, C_DB, "Lê o campo e o clube (404 pitch_not_found)", "SELECT pitches JOIN clubs")
Rel(API_BOOK_SERIES, API_AUTH_ACCOUNTS, "O dono está ativo? (422 club_unavailable)")
Rel(API_BOOK_SERIES, API_BOOK_SERIES, "seriesId = Guid.CreateVersion7(); RecurringOccurrences.Starts(startsAt, weeks, timeZone)")

loop cada data, por ordem (BookOneAsync)
  group Transação própria desta data
    Rel(API_BOOK_SERIES, CC_LOCK, "LockAsync(pitchId)")
    Rel(CC_LOCK, C_DB, "BEGIN; SELECT 1 FROM pitches … FOR UPDATE", "SQL")
    Rel(API_BOOK_SERIES, C_DB, "Volta a ler o campo dentro do trinco", "SELECT pitches")
    Rel(API_BOOK_SERIES, CC_SLOTCHECK, "CheckAsync(pitch, timeZone, startsAt, now)")
    alt recusa
      Rel(API_BOOK_SERIES, API_BOOK_SERIES, "SkippedOccurrence com RecurringOccurrences.ReasonFor: pitch_inactive, outside_window, closed, not_a_slot, started, blocked")
      Rel(CC_LOCK, C_DB, "Sem commit → ROLLBACK", "SQL")
    else livre
      Rel(API_BOOK_SERIES, API_BOOK_SERIES, "Booking.ForPlayer(…, PriceForSlot, now, seriesId)")
      Rel(API_BOOK_SERIES, API_NOTIF_OUTBOX, "EnqueueOwnerNotificationAsync, EnqueueReminder (sem confirmação individual)")
      Rel(API_BOOK_SERIES, API_BOOK_STORE, "TryAddAsync(booking)")
      Rel(API_BOOK_STORE, C_DB, "INSERT bookings e outbox_messages", "SQL")
      alt 23P01 em bookings_no_overlap
        Rel_Back(API_BOOK_SERIES, API_BOOK_STORE, "false → SkippedOccurrence(taken)")
        Rel(CC_LOCK, C_DB, "ROLLBACK", "SQL")
      else inserida
        Rel(CC_LOCK, C_DB, "COMMIT: esta data fica feita, aconteça o que acontecer às seguintes", "SQL")
      end
    end
  end
end

alt nenhuma data feita
  Rel_Back(WEB_F_BOOKING, API_BOOK_SERIES, "409 series_unavailable, extensions.skipped com o motivo de cada data")
else pelo menos uma
  group Transação à parte (a implícita do SaveChanges)
    Rel(API_BOOK_SERIES, API_NOTIF_OUTBOX, "EnqueueSeriesSummaryAsync(created, skipped)")
    Rel(API_BOOK_SERIES, C_DB, "SaveChangesAsync: INSERT outbox_messages (booking_series_confirmed)", "SQL")
  end
  note over API_BOOK_SERIES, C_DB: Se o processo cair antes deste SaveChanges, as reservas ficam e o resumo perde-se (provisório, US20).
  Rel_Back(WEB_F_BOOKING, API_BOOK_SERIES, "201 Created { seriesId, created, skipped }, Location da 1.ª reserva")
end

SHOW_LEGEND()
@enduml
