' plantuml-version: 1.2026.8
@startuml 05-dev-di
title Vista de desenvolvimento · composição da injeção de dependências

skinparam shadowing false
skinparam rectangle {
  BackgroundColor White
  BorderColor #1168BD
}
skinparam ArrowColor #555555
skinparam defaultTextAlignment left

rectangle "L-API · Program.cs\nWebApplication.CreateBuilder(args)\n(no gerador do OpenAPI: definições de substituição em memória)" as PROG
rectangle "L-APP · AddApplication()\nvalidadores (Singleton) e serviços (Scoped):\nOwnedClubs, BookingService, ClubBookingService, …" as ADDAPP
rectangle "L-INF · AddInfrastructure(config)\nTimeProvider.System, AppDbContext, IAppDbContext,\nI*Store, IPitchLock, DemoDataSeeder, HealthChecks" as ADDINF
rectangle "AddAccounts · Identity, IAccountStore, seed do admin,\nData Protection, PasswordHasherOptions" as ADDACC
rectangle "AddSessions · JwtOptions, ISessionService,\nPublicSiteOptions, IPasswordResetStore, AccountEmailBuilder" as ADDSES
rectangle "AddEmail · EmailOptions, OutboxOptions, IEmailSender,\nOutboxProcessor, OutboxDispatcher (HostedService)" as ADDMAIL
rectangle "L-API · extensões próprias\nAddApiProblemDetails, AddOriginCheck, AddApiRateLimiting,\nAddCookieJwtAuthentication\n(AddControllers e AddOpenApi são do framework)" as ADDAPI
rectangle "Pipeline e arranque\nUseForwardedHeaders, UseExceptionHandler, UseOriginCheck,\nUseRateLimiter, UseAuthentication, UseAuthorization;\nvalida as opções, migra, seed do admin, comandos, MapControllers" as PIPE

PROG --> ADDAPP : 1.º
PROG --> ADDINF : 2.º
ADDINF --> ADDACC
ADDINF --> ADDSES
ADDINF --> ADDMAIL
PROG --> ADDAPI : 3.º
PROG --> PIPE : app.Build()

@enduml
