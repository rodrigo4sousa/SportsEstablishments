' plantuml-version: 1.2026.8
@startuml 04-process-reset-confirm
!include <C4/C4_Sequence>

title Definir a nova palavra-passe (US05) · uma só resposta para qualquer ligação má; tudo numa transação

HIDE_STEREOTYPE()

Component(WEB_F_AUTH, "WEB-F-AUTH · Contas", "ResetPasswordForm, confirmPasswordReset")
Container_Boundary(C_API, "C-API · API ASP.NET Core")
  Component(API_AUTH, "API-AUTH · Contas e sessões", "AuthController.ConfirmPasswordReset")
  Component(API_AUTH_RESET, "API-AUTH-RESET · Recuperação", "PasswordResetService.ConfirmAsync, PasswordResetStore.ResetAsync")
  Component(CC_DATAPROT, "CC-DATAPROT · Data Protection", "DataProtectorTokenProvider do Identity")
Boundary_End()
ContainerDb(C_DB, "C-DB · PostgreSQL", "users, refresh_tokens, outbox_messages")

Rel(WEB_F_AUTH, API_AUTH, "POST /api/auth/password-reset/confirm { email, token, newPassword }", "email e token lidos do endereço; [AllowAnonymous], limite por IP")
Rel(API_AUTH, API_AUTH_RESET, "ConfirmAsync")
Rel(API_AUTH_RESET, API_AUTH_RESET, "Valida newPassword (400 no campo); email ou token vazios → 400 invalid_or_expired_reset_link")
Rel(API_AUTH_RESET, C_DB, "FindByEmailAsync e elegibilidade (Player ou Owner ativo)", "SELECT users")
group Transação
  Rel(API_AUTH_RESET, CC_DATAPROT, "UserManager.ResetPasswordAsync(user, token, newPassword)")
  Rel(CC_DATAPROT, C_DB, "Valida finalidade, validade (relógio do sistema) e security stamp", "SELECT data_protection_keys")
  alt token errado, expirado ou já usado
    Rel(API_AUTH_RESET, C_DB, "ROLLBACK", "SQL")
    Rel_Back(WEB_F_AUTH, API_AUTH, "400 invalid_or_expired_reset_link (o mesmo para conta desconhecida)")
  else válido
    Rel(API_AUTH_RESET, C_DB, "Novo hash e novo security stamp: este token e os anteriores deixam de valer", "UPDATE users")
    Rel(API_AUTH_RESET, C_DB, "Revoga todas as sessões", "UPDATE refresh_tokens SET revoked_at")
    Rel(API_AUTH_RESET, C_DB, "ResetAccessFailedCountAsync, SetLockoutEndDateAsync(null)", "UPDATE users")
    Rel(API_AUTH_RESET, C_DB, "INSERT outbox_messages (password_changed); COMMIT", "SQL")
    Rel_Back(WEB_F_AUTH, API_AUTH, "204; ninguém fica com sessão iniciada")
  end
end

SHOW_LEGEND()
@enduml
