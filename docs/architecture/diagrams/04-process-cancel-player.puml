' plantuml-version: 1.2026.8
@startuml 04-process-cancel-player
!include <C4/C4_Sequence>

title Jogador cancela (US19) · a janela lida nesse momento, e dois cancelamentos ao mesmo tempo

HIDE_STEREOTYPE()

Component(WEB_F_MYBOOK, "WEB-F-MYBOOK · As minhas reservas", "MyBookings, cancelBooking")
Container_Boundary(C_API, "C-API · API ASP.NET Core")
  Component(API_BOOK_MINE, "API-BOOK-MINE · Cancelar", "BookingCancellationService.CancelAsync")
  Component(CC_LOCK, "CC-LOCK · Trinco do campo", "IPitchLock, PitchLock")
  Component(API_NOTIF_OUTBOX, "API-NOTIF-OUTBOX · Pôr no outbox", "BookingEmailOutbox")
Boundary_End()
ContainerDb(C_DB, "C-DB · PostgreSQL", "bookings, pitches, clubs, outbox_messages")

Rel(WEB_F_MYBOOK, API_BOOK_MINE, "POST /api/bookings/{id}/cancel", "apiJson; política Player")
Rel(API_BOOK_MINE, C_DB, "pitch_id da reserva, só se for do jogador da sessão (404 booking_not_found)", "SELECT bookings")
group Transação do trinco
  Rel(API_BOOK_MINE, CC_LOCK, "LockAsync(pitchId)")
  Rel(CC_LOCK, C_DB, "BEGIN; SELECT 1 FROM pitches … FOR UPDATE", "SQL")
  Rel(API_BOOK_MINE, C_DB, "Volta a ler a reserva (com tracking)", "SELECT bookings")
  Rel(API_BOOK_MINE, C_DB, "A janela do clube agora, nunca a da reserva", "SELECT clubs.cancellation_window_hours")
  Rel(API_BOOK_MINE, API_BOOK_MINE, "booking.CancelByPlayer(window, now) → CancellationOutcome")
  alt NotConfirmed
    Rel_Back(WEB_F_MYBOOK, API_BOOK_MINE, "422 booking_not_confirmed (ROLLBACK ao descartar)")
  else OutsideWindow (now ≥ startsAt − janela)
    Rel_Back(WEB_F_MYBOOK, API_BOOK_MINE, "422 outside_cancellation_window, extensão cancellationDeadline (UTC)")
  else Cancelled
    Rel(API_BOOK_MINE, API_NOTIF_OUTBOX, "EnqueuePlayerCancellationAsync(booking)")
    Rel(API_BOOK_MINE, C_DB, "SaveChanges: UPDATE bookings (CancelledByPlayer, cancelled_at) e INSERT outbox_messages", "SQL")
    Rel(CC_LOCK, C_DB, "COMMIT; o slot volta a estar livre (a constraint só vê Confirmed)", "SQL")
    Rel_Back(WEB_F_MYBOOK, API_BOOK_MINE, "200 MyBookingResponse")
  end
end

== Dois cancelamentos da mesma reserva ao mesmo tempo (dois separadores, duplo clique) ==

Rel(WEB_F_MYBOOK, API_BOOK_MINE, "Pedido A: POST …/cancel")
Rel(WEB_F_MYBOOK, API_BOOK_MINE, "Pedido B: POST …/cancel")
Rel(CC_LOCK, C_DB, "A obtém FOR UPDATE; B fica à espera na mesma linha de pitches", "SQL")
Rel(API_BOOK_MINE, C_DB, "A: relê Confirmed, cancela, COMMIT", "SQL")
Rel(API_BOOK_MINE, C_DB, "B: obtém o trinco e relê a reserva já CancelledByPlayer", "SQL")
Rel_Back(WEB_F_MYBOOK, API_BOOK_MINE, "A: 200")
Rel_Back(WEB_F_MYBOOK, API_BOOK_MINE, "B: 422 booking_not_confirmed (nunca 500, nunca dois emails)")

SHOW_LEGEND()
@enduml
