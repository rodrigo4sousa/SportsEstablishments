' 4+1 vista lógica - Modelo do domínio · clubes, campos, bloqueios e reservas
' Version 1.1 - 2026-11-10
' Para: quem programa.
' Decisão documentada: Entidades com setters privados e métodos com intenção; o Domain não conhece a persistência, o HTTP nem os ecrãs.
' Não desenhado: controllers, HTTP e ecrãs; as contas estão em logical-domain-accounts.
@startuml logical-domain-booking
!include ../style.puml
title Vista lógica - modelo do domínio: clubes, campos, bloqueios e reservas

hide empty members

package "Domain" as L_DOM {
  class "Club" as D_CLUB {
    Id : Guid
    OwnerId : Guid
    Slug : string
    Name, Address, Locality, Phone, ContactEmail : string
    LocalityKey : string
    CancellationWindowHours : int
    NotifyOnNewBooking : bool
    TimeZoneId : string
    --
    {static} Create(ownerId, slug, details, cancellationWindowHours, now)
    UpdateDetails(details, now)
    ChangeCancellationWindow(hours, now)
    ChangeNotifyOnNewBooking(notify, now)
  }

  class "Pitch" as D_PITCH {
    Id : Guid
    ClubId : Guid
    Name, NameKey : string
    Sport : Sport
    PricePerSlot : decimal
    Status : PitchStatus
    SlotDurationMinutes : int
    --
    {static} Create(clubId, details, now)
    UpdateDetails(details, now)
    Deactivate(now) / Reactivate(now)
    ChangeSchedule(duration, week, now)
    SlotsOn(date, timeZone)
    SlotStartingAt(startsAtUtc, timeZone)
    PriceForSlot(startsAtUtc, timeZone)
    TryAddPriceBand(details, now, out band)
    TryChangePriceBand(band, details, now)
    RemovePriceBand(band)
  }

  class "PitchOpeningDay" as D_OPENDAY {
    Day : DayOfWeek
    Opens : TimeOnly
    Closes : TimeOnly
    --
    Hours : OpeningHours
  }

  class "PitchPriceBand" as D_PRICEBAND {
    Id : Guid
    PitchId : Guid
    DaysMask : int
    Starts : TimeOnly
    Ends : TimeOnly
    Price : decimal
    --
    Covers(day, time)
    Overlaps(other)
  }

  class "Block" as D_BLOCK {
    Id : Guid
    PitchId : Guid
    StartsAt : DateTime (UTC)
    EndsAt : DateTime (UTC)
    Reason : string?
    --
    {static} Create(pitchId, startsAt, endsAt, reason, now)
    HasStarted(now)
    Overlaps(startsAt, endsAt)
  }

  class "Booking" as D_BOOKING {
    Id : Guid
    PitchId : Guid
    PlayerId : Guid?
    CustomerName : string?
    CustomerPhone : string?
    StartsAt : DateTime (UTC)
    EndsAt : DateTime (UTC)
    Price : decimal
    Status : BookingStatus
    SeriesId : Guid?
    CancelledAt : DateTime?
    CancellationReason : string?
    --
    {static} ForPlayer(…) / ForCustomer(…)
    CancelByPlayer(window, now)
    CancelByClub(reason, now)
    RecordNoShow(now) / UndoNoShow()
  }

  enum "Sport" as D_PITCH_Sport {
    Futsal
    Football7
    Padel
    Tennis
  }

  enum "PitchStatus" as D_PITCH_PitchStatus {
    Active
    Inactive
  }

  enum "BookingStatus" as D_BOOKING_BookingStatus {
    Confirmed
    CancelledByPlayer
    CancelledByClub
    NoShow
  }
}

package "Infrastructure" as L_INF {
  class "AppUser" as D_USER {
    Id : Guid
    Email, Name : string
    DeactivatedAt : DateTime?
  }
}

D_CLUB "0..*" --> "1" D_USER : OwnerId (dono)
D_PITCH "0..*" --> "1" D_CLUB : ClubId
D_PITCH *-- "0..7" D_OPENDAY : OpeningDays
D_PITCH *-- "0..20" D_PRICEBAND : PriceBands
D_BLOCK "0..*" --> "1" D_PITCH : PitchId
D_BOOKING "0..*" --> "1" D_PITCH : PitchId
D_BOOKING "0..*" --> "0..1" D_USER : PlayerId (jogador)
D_PITCH ..> D_PITCH_Sport
D_PITCH ..> D_PITCH_PitchStatus
D_BOOKING ..> D_BOOKING_BookingStatus

note right of D_BOOKING
  De um jogador (PlayerId) **ou** de um cliente
  (CustomerName + CustomerPhone), nunca os dois
  nem nenhum: ck_bookings_player_or_customer.
  SeriesId é só um Guid partilhado pelas reservas
  de um pedido semanal; não há entidade «série».
end note

@enduml
