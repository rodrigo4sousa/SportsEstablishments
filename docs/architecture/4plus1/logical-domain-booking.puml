' 4+1 vista lógica - Modelo do domínio · clubes, campos, bloqueios e reservas
' Version 1.0 - 2026-11-09
' For: quem programa.
' Decision documented: Entidades com setters privados e métodos com intenção; o Domain não conhece a persistência, o HTTP nem os ecrãs.
' Not drawn: controllers, HTTP e ecrãs; as contas estão em logical-domain-accounts.
@startuml logical-domain-booking
!include ../style.puml
title Modelo do domínio · clubes, campos, bloqueios e reservas

hide empty members

package "SportsBooking.Domain (L-DOM)" {
  class Club <<D-CLUB>> {
    Id : Guid
    OwnerId : Guid
    Slug : string
    Name, Address, Locality, Phone, ContactEmail : string
    LocalityKey : string
    CancellationWindowHours : int
    NotifyOnNewBooking : bool
    TimeZoneId : string
    --
    {static} Create(ownerId, slug, details, cancellationWindowHours, now)
    UpdateDetails(details, now)
    ChangeCancellationWindow(hours, now)
    ChangeNotifyOnNewBooking(notify, now)
  }

  class Pitch <<D-PITCH>> {
    Id : Guid
    ClubId : Guid
    Name, NameKey : string
    Sport : Sport
    PricePerSlot : decimal
    Status : PitchStatus
    SlotDurationMinutes : int
    --
    {static} Create(clubId, details, now)
    UpdateDetails(details, now)
    Deactivate(now) / Reactivate(now)
    ChangeSchedule(duration, week, now)
    SlotsOn(date, timeZone)
    SlotStartingAt(startsAtUtc, timeZone)
    PriceForSlot(startsAtUtc, timeZone)
    TryAddPriceBand(details, now, out band)
    TryChangePriceBand(band, details, now)
    RemovePriceBand(band)
  }

  class PitchOpeningDay <<D-OPENDAY>> {
    Day : DayOfWeek
    Opens : TimeOnly
    Closes : TimeOnly
    --
    Hours : OpeningHours
  }

  class PitchPriceBand <<D-PRICEBAND>> {
    Id : Guid
    PitchId : Guid
    DaysMask : int
    Starts : TimeOnly
    Ends : TimeOnly
    Price : decimal
    --
    Covers(day, time)
    Overlaps(other)
  }

  class Block <<D-BLOCK>> {
    Id : Guid
    PitchId : Guid
    StartsAt : DateTime (UTC)
    EndsAt : DateTime (UTC)
    Reason : string?
    --
    {static} Create(pitchId, startsAt, endsAt, reason, now)
    HasStarted(now)
    Overlaps(startsAt, endsAt)
  }

  class Booking <<D-BOOKING>> {
    Id : Guid
    PitchId : Guid
    PlayerId : Guid?
    CustomerName : string?
    CustomerPhone : string?
    StartsAt : DateTime (UTC)
    EndsAt : DateTime (UTC)
    Price : decimal
    Status : BookingStatus
    SeriesId : Guid?
    CancelledAt : DateTime?
    CancellationReason : string?
    --
    {static} ForPlayer(…) / ForCustomer(…)
    CancelByPlayer(window, now)
    CancelByClub(reason, now)
    RecordNoShow(now) / UndoNoShow()
  }

  enum Sport <<D-PITCH>> {
    Futsal
    Football7
    Padel
    Tennis
  }

  enum PitchStatus <<D-PITCH>> {
    Active
    Inactive
  }

  enum BookingStatus <<D-BOOKING>> {
    Confirmed
    CancelledByPlayer
    CancelledByClub
    NoShow
  }
}

package "SportsBooking.Infrastructure (L-INF)" {
  class AppUser <<D-USER>> {
    Id : Guid
    Email, Name : string
    DeactivatedAt : DateTime?
  }
}

Club "0..*" --> "1" AppUser : OwnerId (dono)
Pitch "0..*" --> "1" Club : ClubId
Pitch *-- "0..7" PitchOpeningDay : OpeningDays
Pitch *-- "0..20" PitchPriceBand : PriceBands
Block "0..*" --> "1" Pitch : PitchId
Booking "0..*" --> "1" Pitch : PitchId
Booking "0..*" --> "0..1" AppUser : PlayerId (jogador)
Pitch ..> Sport
Pitch ..> PitchStatus
Booking ..> BookingStatus

note right of Booking
  De um jogador (PlayerId) **ou** de um cliente
  (CustomerName + CustomerPhone), nunca os dois
  nem nenhum: ck_bookings_player_or_customer.
  SeriesId é só um Guid partilhado pelas reservas
  de um pedido semanal; não há entidade «série».
end note

@enduml
