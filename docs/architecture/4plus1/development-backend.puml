' 4+1 vista de desenvolvimento - Vista de desenvolvimento · projetos do back end e referências
' Version 1.1 - 2026-11-10
' Para: quem vai mudar o código.
' Decisão documentada: Um projeto .NET por camada, com referências só para dentro.
' Não desenhado: classes, endpoints e regras de negócio.
@startuml development-backend
!include ../style.puml
title Vista de desenvolvimento - projetos do back end e referências

package "backend/src" {
  component "SportsBooking.Api\n(Microsoft.NET.Sdk.Web)" as L_API
  component "SportsBooking.Infrastructure\n(FrameworkReference Microsoft.AspNetCore.App)" as L_INF
  component "SportsBooking.Application" as L_APP
  component "SportsBooking.Domain\n(sem pacotes)" as L_DOM
}

package "backend/tests" {
  component "SportsBooking.UnitTests" as DEV_TEST_UNIT
  component "SportsBooking.IntegrationTests" as DEV_TEST_INT
}

L_API --> L_INF : ProjectReference
L_INF --> L_APP : ProjectReference
L_APP --> L_DOM : ProjectReference

DEV_TEST_UNIT --> L_DOM : ProjectReference
DEV_TEST_UNIT --> L_API : ProjectReference\n(+ InternalsVisibleTo)
DEV_TEST_INT --> L_API : ProjectReference

note right of L_API
  Não referencia Application nem Domain diretamente:
  chega-lhes por Infrastructure (referências transitivas).
end note

note bottom of DEV_TEST_UNIT
  Chega a Application e Infrastructure pela referência a Api.
end note

@enduml
