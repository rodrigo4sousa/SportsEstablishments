' 4+1 vista de desenvolvimento - Vista de desenvolvimento · estrutura do repositório
' Version 1.3 - 2026-11-10
' Para: quem vai mudar o código.
' Decisão documentada: Um só repositório com o back end, o front end, a documentação e o CI.
' Não desenhado: classes, endpoints e regras de negócio.
@startuml development-repo
!include ../style.puml
title Vista de desenvolvimento - estrutura do repositório

skinparam defaultTextAlignment left

folder "/ · raiz do repositório" as ROOT {
  rectangle "Configuração da raiz\nglobal.json (SDK), .editorconfig, .gitattributes,\n.gitignore, .env.example, README.md, AGENTS.md,\nLICENSE, SECURITY.md" as DEV_ROOTCFG
  rectangle "docker-compose.yml\npostgres, mailpit, api, frontend\n(e2e/: compose.e2e.yml e os testes Playwright)" as DEV_COMPOSE

  folder "backend/" as DEV_BACKEND {
    rectangle "src/\nDomain, Application, Infrastructure, Api" as B_SRC
    rectangle "tests/\ntestes unitários, testes de integração" as B_TESTS
    rectangle "Directory.Build.props, Directory.Packages.props,\ndotnet-tools.json, SportsBooking.slnx, Dockerfile" as B_CFG
  }

  folder "frontend/" as DEV_FRONTEND {
    rectangle "src/\napp, components, features, lib, test, proxy.ts\n(testes do front end: ficheiros *.test.ts(x) ao lado do código)" as F_SRC
    rectangle "package.json, package-lock.json, next.config.ts,\nvitest.config.mts, eslint.config.mjs, tsconfig.json,\ncomponents.json, Dockerfile" as F_CFG
  }

  folder "docs/" as DEV_DOCS {
    rectangle "backlog.md, stack.md" as D_SRC
    folder "architecture/" as DEV_ARCHDOCS {
      rectangle "README.md, inventory.md, style.puml, render.sh, render.ps1,\nc4/ e 4plus1/ (.md e .puml), out/ (.svg), fonts/, adr/" as A_SRC
    }
  }

  folder "scripts/" as DEV_SCRIPTS {
    rectangle "check-architecture-docs.sh, check-architecture-docs.ps1" as S_SRC
  }

  folder ".github/workflows/" as DEV_WORKFLOWS {
    rectangle "ci.yml\njobs: backend, frontend, diagrams\ncodeql.yml\ne2e.yml\ndeploy.yml, prod-data.yml, keepalive.yml" as W_SRC
  }
}

DEV_COMPOSE ..> DEV_BACKEND : "imagem da API"
DEV_COMPOSE ..> DEV_FRONTEND : "imagem do front end"
DEV_WORKFLOWS ..> DEV_BACKEND : "CI backend"
DEV_WORKFLOWS ..> DEV_FRONTEND : "CI frontend"
DEV_WORKFLOWS ..> DEV_ARCHDOCS : "CI diagramas: render.sh desenha os .puml em out/"
DEV_WORKFLOWS ..> DEV_SCRIPTS : "CI docs: ligações e galeria"
DEV_WORKFLOWS ..> DEV_COMPOSE : "e2e.yml: sobe a stack e corre o Playwright de e2e/"
DEV_SCRIPTS ..> DEV_ARCHDOCS : "lê os .md e out/"

@enduml
