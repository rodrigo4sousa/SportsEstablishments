' 4+1 development view - Development view · repository structure
' Version 1.4 - 2026-11-10
' For: whoever is going to change the code.
' Documented decision: A single repository with the back end, the front end, the documentation and CI.
' Not drawn: classes, endpoints and business rules.
@startuml development-repo
!include ../style.puml
title Development view - repository structure

skinparam defaultTextAlignment left

folder "/ · repository root" as ROOT {
  rectangle "Root configuration\nglobal.json (SDK), .editorconfig, .gitattributes,\n.gitignore, .env.example, README.md, AGENTS.md,\nLICENSE, SECURITY.md" as DEV_ROOTCFG
  rectangle "docker-compose.yml\npostgres, mailpit, api, frontend\n(e2e/: compose.e2e.yml and the Playwright tests)" as DEV_COMPOSE

  folder "backend/" as DEV_BACKEND {
    rectangle "src/\nDomain, Application, Infrastructure, Api" as B_SRC
    rectangle "tests/\nunit tests, integration tests" as B_TESTS
    rectangle "Directory.Build.props, Directory.Packages.props,\ndotnet-tools.json, SportsBooking.slnx, Dockerfile" as B_CFG
  }

  folder "frontend/" as DEV_FRONTEND {
    rectangle "src/\napp, components, features, lib, test, proxy.ts\n(front end tests: *.test.ts(x) files next to the code)" as F_SRC
    rectangle "package.json, package-lock.json, next.config.ts,\nvitest.config.mts, eslint.config.mjs, tsconfig.json,\ncomponents.json, Dockerfile" as F_CFG
  }

  folder "docs/" as DEV_DOCS {
    rectangle "backlog.md, stack.md" as D_SRC
    folder "architecture/" as DEV_ARCHDOCS {
      rectangle "README.md, inventory.md, style.puml, render.sh, render.ps1,\nc4/ and 4plus1/ (.md and .puml), out/ (.svg), fonts/, adr/" as A_SRC
    }
  }

  folder "scripts/" as DEV_SCRIPTS {
    rectangle "check-architecture-docs.sh, check-architecture-docs.ps1,\ngenerate-icons.mjs" as S_SRC
  }

  folder ".github/workflows/" as DEV_WORKFLOWS {
    rectangle "ci.yml\njobs: backend, frontend, diagrams\ncodeql.yml\ne2e.yml\ndeploy.yml, prod-data.yml, keepalive.yml" as W_SRC
  }
}

DEV_COMPOSE ..> DEV_BACKEND : "API image"
DEV_COMPOSE ..> DEV_FRONTEND : "front end image"
DEV_WORKFLOWS ..> DEV_BACKEND : "backend CI"
DEV_WORKFLOWS ..> DEV_FRONTEND : "frontend CI"
DEV_WORKFLOWS ..> DEV_ARCHDOCS : "diagrams CI: render.sh draws the .puml files into out/"
DEV_WORKFLOWS ..> DEV_SCRIPTS : "docs CI: links and gallery"
DEV_WORKFLOWS ..> DEV_COMPOSE : "e2e.yml: brings up the stack and runs the Playwright tests in e2e/"
DEV_SCRIPTS ..> DEV_ARCHDOCS : "reads the .md files and out/"

@enduml
