' 4+1 process view - Weekly series (US20) · one transaction per date, partial success and the summary at the end
' Version 1.1 - 2026-11-10
' For: whoever writes code and whoever debugs.
' Documented decision: One transaction per date, partial success and a summary at the end (US20).
' Not drawn: internal detail of the classes; refusals that do not change the sequence (they are in the text of process.md).
@startuml process-series
!include ../style.puml

title Process view - weekly series (US20): one transaction per date, partial success and the summary at the end
autonumber

participant "Booking" as WEB_F_BOOKING
box "ASP.NET Core API"
  participant "Weekly series" as API_BOOK_SERIES
  participant "Accounts" as API_AUTH_ACCOUNTS
  participant "Pitch lock" as CC_LOCK
  participant "Slot check" as CC_SLOTCHECK
  participant "Put in the outbox" as API_NOTIF_OUTBOX
  participant "Booking store" as API_BOOK_STORE
end box
database "PostgreSQL" as C_DB

WEB_F_BOOKING -> API_BOOK_SERIES : POST /api/bookings/recurring { pitchId, startsAt, weeks }\n[apiJson; Player policy]
API_BOOK_SERIES -> API_BOOK_SERIES : Validates (400; weeks from 1 to 4)
API_BOOK_SERIES -> C_DB : Reads the pitch and the club (404 pitch_not_found) [SELECT pitches JOIN\nclubs]
API_BOOK_SERIES -> API_AUTH_ACCOUNTS : Is the owner active? (422 club_unavailable)
API_BOOK_SERIES -> API_BOOK_SERIES : seriesId = Guid.CreateVersion7();\nRecurringOccurrences.Starts(startsAt, weeks, timeZone)

loop each date, in order (BookOneAsync)
  group This date's own transaction
    API_BOOK_SERIES -> CC_LOCK : LockAsync(pitchId)
    CC_LOCK -> C_DB : BEGIN; SELECT 1 FROM pitches … FOR UPDATE [SQL]
    API_BOOK_SERIES -> C_DB : Reads the pitch again inside the lock [SELECT pitches]
    API_BOOK_SERIES -> CC_SLOTCHECK : CheckAsync(pitch, timeZone, startsAt, now)
    alt refusal
      API_BOOK_SERIES -> API_BOOK_SERIES : SkippedOccurrence with RecurringOccurrences.ReasonFor:\npitch_inactive, outside_window, closed, not_a_slot, started,\nblocked
      CC_LOCK -> C_DB : No commit → ROLLBACK [SQL]
    else free
      API_BOOK_SERIES -> API_BOOK_SERIES : Booking.ForPlayer(…, PriceForSlot, now, seriesId)
      API_BOOK_SERIES -> API_NOTIF_OUTBOX : EnqueueOwnerNotificationAsync, EnqueueReminder (no individual\nconfirmation)
      API_BOOK_SERIES -> API_BOOK_STORE : TryAddAsync(booking)
      API_BOOK_STORE -> C_DB : INSERT bookings and outbox_messages [SQL]
      alt 23P01 on bookings_no_overlap
        API_BOOK_STORE --> API_BOOK_SERIES : false → SkippedOccurrence(taken)
        CC_LOCK -> C_DB : ROLLBACK [SQL]
      else inserted
        CC_LOCK -> C_DB : COMMIT: this date is done, whatever happens to the\nfollowing ones [SQL]
      end
    end
  end
end

alt no date done
  API_BOOK_SERIES --> WEB_F_BOOKING : 409 series_unavailable, extensions.skipped with the reason for each\ndate
else at least one
  group Separate transaction (SaveChanges' implicit one)
    API_BOOK_SERIES -> API_NOTIF_OUTBOX : EnqueueSeriesSummaryAsync(created, skipped)
    API_BOOK_SERIES -> C_DB : SaveChangesAsync: INSERT outbox_messages\n(booking_series_confirmed) [SQL]
  end
  note over API_BOOK_SERIES, C_DB: If the process crashes before this SaveChanges, the bookings stay and the summary\nis lost (provisional, US20).
  API_BOOK_SERIES --> WEB_F_BOOKING : 201 Created { seriesId, created, skipped }, Location of the 1st\nbooking
end
@enduml
