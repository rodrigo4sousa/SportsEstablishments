' 4+1 vista de processo - Série semanal (US20) · uma transação por data, sucesso parcial e o resumo no fim
' Version 1.1 - 2026-11-10
' Para: quem programa e quem depura.
' Decisão documentada: Uma transação por data, sucesso parcial e um resumo no fim (US20).
' Não desenhado: detalhe interno das classes; recusas que não mudam a sequência (estão no texto de process.md).
@startuml process-series
!include ../style.puml

title Vista de processo - série semanal (US20): uma transação por data, sucesso parcial e o resumo no fim
autonumber

participant "Reservar" as WEB_F_BOOKING
box "API ASP.NET Core"
  participant "Série semanal" as API_BOOK_SERIES
  participant "Contas" as API_AUTH_ACCOUNTS
  participant "Trinco do campo" as CC_LOCK
  participant "Verificação do slot" as CC_SLOTCHECK
  participant "Pôr no outbox" as API_NOTIF_OUTBOX
  participant "Store das reservas" as API_BOOK_STORE
end box
database "PostgreSQL" as C_DB

WEB_F_BOOKING -> API_BOOK_SERIES : POST /api/bookings/recurring { pitchId, startsAt, weeks }\n[apiJson; política Player]
API_BOOK_SERIES -> API_BOOK_SERIES : Valida (400; weeks de 1 a 4)
API_BOOK_SERIES -> C_DB : Lê o campo e o clube (404 pitch_not_found) [SELECT pitches JOIN\nclubs]
API_BOOK_SERIES -> API_AUTH_ACCOUNTS : O dono está ativo? (422 club_unavailable)
API_BOOK_SERIES -> API_BOOK_SERIES : seriesId = Guid.CreateVersion7();\nRecurringOccurrences.Starts(startsAt, weeks, timeZone)

loop cada data, por ordem (BookOneAsync)
  group Transação própria desta data
    API_BOOK_SERIES -> CC_LOCK : LockAsync(pitchId)
    CC_LOCK -> C_DB : BEGIN; SELECT 1 FROM pitches … FOR UPDATE [SQL]
    API_BOOK_SERIES -> C_DB : Volta a ler o campo dentro do trinco [SELECT pitches]
    API_BOOK_SERIES -> CC_SLOTCHECK : CheckAsync(pitch, timeZone, startsAt, now)
    alt recusa
      API_BOOK_SERIES -> API_BOOK_SERIES : SkippedOccurrence com RecurringOccurrences.ReasonFor:\npitch_inactive, outside_window, closed, not_a_slot, started,\nblocked
      CC_LOCK -> C_DB : Sem commit → ROLLBACK [SQL]
    else livre
      API_BOOK_SERIES -> API_BOOK_SERIES : Booking.ForPlayer(…, PriceForSlot, now, seriesId)
      API_BOOK_SERIES -> API_NOTIF_OUTBOX : EnqueueOwnerNotificationAsync, EnqueueReminder (sem confirmação\nindividual)
      API_BOOK_SERIES -> API_BOOK_STORE : TryAddAsync(booking)
      API_BOOK_STORE -> C_DB : INSERT bookings e outbox_messages [SQL]
      alt 23P01 em bookings_no_overlap
        API_BOOK_STORE --> API_BOOK_SERIES : false → SkippedOccurrence(taken)
        CC_LOCK -> C_DB : ROLLBACK [SQL]
      else inserida
        CC_LOCK -> C_DB : COMMIT: esta data fica feita, aconteça o que acontecer às\nseguintes [SQL]
      end
    end
  end
end

alt nenhuma data feita
  API_BOOK_SERIES --> WEB_F_BOOKING : 409 series_unavailable, extensions.skipped com o motivo de cada\ndata
else pelo menos uma
  group Transação à parte (a implícita do SaveChanges)
    API_BOOK_SERIES -> API_NOTIF_OUTBOX : EnqueueSeriesSummaryAsync(created, skipped)
    API_BOOK_SERIES -> C_DB : SaveChangesAsync: INSERT outbox_messages\n(booking_series_confirmed) [SQL]
  end
  note over API_BOOK_SERIES, C_DB: Se o processo cair antes deste SaveChanges, as reservas ficam e o resumo\nperde-se (provisório, US20).
  API_BOOK_SERIES --> WEB_F_BOOKING : 201 Created { seriesId, created, skipped }, Location da 1.ª\nreserva
end
@enduml
