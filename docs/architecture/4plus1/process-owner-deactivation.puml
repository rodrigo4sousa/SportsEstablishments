' 4+1 vista de processo - Desativar um dono (US29) · atualização condicional, registo de auditoria e revogação numa transação
' Version 1.0 - 2026-11-09
' For: quem programa e quem depura.
' Decision documented: Atualização condicional, registo de auditoria e revogação das sessões numa só transação (US29).
' Not drawn: detalhe interno das classes; recusas que não mudam a sequência (estão no texto de process.md).
@startuml process-owner-deactivation
!include <C4/C4_Sequence>
!include ../style.puml

title Desativar um dono (US29) · atualização condicional, registo de auditoria e revogação numa transação

Component(WEB_F_ADMIN, "WEB-F-ADMIN · Página do dono", "OwnerStatusForm, changeOwnerStatus")
Container_Boundary(C_API, "C-API · API ASP.NET Core")
  Component(CC_AUTHZ, "CC-AUTHZ · Autorização", "política Admin, ICurrentUser")
  Component(API_ADMIN, "API-ADMIN · Administração", "AdminOwnerStatusService, AdminOwnersService, OwnerStatusStore.TryChangeAsync")
Boundary_End()
ComponentDb(DB_USERS, "DB-USERS · users", "Tabela")
ComponentDb(DB_STATUSCHG, "DB-STATUSCHG · owner_status_changes", "Tabela, só de acrescentar (DB-AUDITTRG)")
ComponentDb(DB_REFRESH, "DB-REFRESH · refresh_tokens", "Tabela")

Rel(WEB_F_ADMIN, CC_AUTHZ, $plain("POST /api/admin/owners/{id}/deactivate { reason }"), "apiJson")
Rel(CC_AUTHZ, API_ADMIN, $plain("Sessão Admin (senão 401 ou 403) → DeactivateAsync"))
Rel(API_ADMIN, DB_USERS, $plain("AdminOwnersService.GetAsync: um dono? (404 owner_not_found, também para jogador ou admin), antes do corpo"), "SELECT")
Rel(API_ADMIN, API_ADMIN, $plain("Valida reason: obrigatório, aparado, ≤ 500 (400)"))
Rel(API_ADMIN, CC_AUTHZ, $plain("adminId = ICurrentUser.UserId (da sessão, nunca do pedido)"))
group Transação (TryChangeAsync)
  Rel(API_ADMIN, DB_USERS, $plain("UPDATE users SET deactivated_at = now WHERE id = … AND deactivated_at IS NULL"), "ExecuteUpdate")
  alt 0 linhas (já desativado, ou outro admin ganhou)
    Rel(API_ADMIN, DB_USERS, $plain("ROLLBACK"), "SQL")
    Rel_Back(WEB_F_ADMIN, API_ADMIN, $plain("422 owner_already_deactivated"))
  else 1 linha
    Rel(API_ADMIN, DB_STATUSCHG, $plain("OwnerStatusChange.Record(ownerId, Deactivated, reason, adminId, now)"), "INSERT")
    Rel(API_ADMIN, DB_REFRESH, $plain("Revoga todos os refresh tokens do dono"), "UPDATE … SET revoked_at WHERE user_id = … AND revoked_at IS NULL")
    Rel(API_ADMIN, DB_USERS, $plain("COMMIT"), "SQL")
    Rel(API_ADMIN, DB_USERS, $plain("GetAsync outra vez (futureBookings: reservas que continuam confirmadas)"), "SELECT")
    Rel_Back(WEB_F_ADMIN, API_ADMIN, $plain("200 AdminOwnerDetailResponse"))
    Rel(WEB_F_ADMIN, WEB_F_ADMIN, $plain("invalidateQueries(['admin'])"))
  end
end
note over WEB_F_ADMIN, DB_REFRESH: Nenhuma reserva é cancelada. O access token já emitido vale até 15 min (aceite).\nDepois: login, refresh, páginas públicas e novas reservas recusam pelas verificações de deactivated_at.

SHOW_LEGEND()
@enduml
