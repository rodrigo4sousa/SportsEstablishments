' 4+1 vista de processo - Login e logout (US03) · uma só resposta para qualquer falha; o logout revoga o refresh token
' Version 1.0 - 2026-11-09
' Para: quem programa e quem depura.
' Decisão documentada: Uma só resposta (401 invalid_credentials) para qualquer falha de login, e sessões em cookies httpOnly (ADR 0002).
' Não desenhado: detalhe interno das classes; recusas que não mudam a sequência (estão no texto de process.md).
@startuml process-login
!include <C4/C4_Sequence>
!include ../style.puml

title Login e logout (US03) · uma só resposta para qualquer falha; o logout revoga o refresh token

Component(WEB_F_AUTH, "WEB-F-AUTH · Contas", "LoginForm, LogoutButton, login, logout")
Container_Boundary(C_API, "C-API · API ASP.NET Core")
  Component(API_AUTH, "API-AUTH · Contas e sessões", "AuthController")
  Component(API_AUTH_LOGIN, "API-AUTH-LOGIN · Login", "LoginService.LoginAsync")
  Component(API_AUTH_ACCOUNTS, "API-AUTH-ACCOUNTS · Contas no Identity", "AccountStore.AuthenticateAsync")
  Component(CC_COOKIES, "CC-COOKIES · Sessões e cookies", "SessionService, AuthCookies")
Boundary_End()
ContainerDb(C_DB, "C-DB · PostgreSQL", "users, user_roles, refresh_tokens")

== Login ==
Rel(WEB_F_AUTH, API_AUTH, $plain("POST /api/auth/login { email, password }"), "apiJson; [AllowAnonymous], limite auth-login")
Rel(API_AUTH, API_AUTH_LOGIN, $plain("LoginAsync(request)"))
Rel(API_AUTH_LOGIN, API_AUTH_LOGIN, $plain("Valida campos vazios (400 validation_failed)"))
Rel(API_AUTH_LOGIN, API_AUTH_ACCOUNTS, $plain("AuthenticateAsync(email, password)"))
Rel(API_AUTH_ACCOUNTS, C_DB, $plain("UserManager.FindByEmailAsync"), "SELECT users")
alt sem conta, desativada ou bloqueada
  Rel(API_AUTH_ACCOUNTS, API_AUTH_ACCOUNTS, $plain("FallbackPasswordHash.Verify: o mesmo trabalho PBKDF2, para o tempo não denunciar o caso"))
else palavra-passe errada
  Rel(API_AUTH_ACCOUNTS, C_DB, $plain("AccessFailedAsync (5 seguidas → bloqueio de 15 min)"), "UPDATE users")
else certa
  Rel(API_AUTH_ACCOUNTS, C_DB, $plain("ResetAccessFailedCountAsync; o hash antigo é refeito se tiver menos iterações"), "UPDATE users")
end
alt null
  Rel_Back(WEB_F_AUTH, API_AUTH, $plain("401 invalid_credentials (igual para todas as falhas)"))
else conta
  Rel(API_AUTH_LOGIN, CC_COOKIES, $plain("SessionService.StartAsync(userId, profile)"))
  Rel(CC_COOKIES, C_DB, $plain("RefreshToken.Issue: 32 bytes aleatórios; guarda só o SHA-256, expira em 7 dias"), "INSERT refresh_tokens")
  Rel(CC_COOKIES, CC_COOKIES, $plain("JWT HS256 com sub e role, 15 min"))
  Rel(API_AUTH, CC_COOKIES, $plain("AuthCookies.Append: access_token (Path=/, Lax) e refresh_token (Path=/api/auth, Strict)"))
  Rel_Back(WEB_F_AUTH, API_AUTH, $plain("200 AccountResponse + Set-Cookie"))
  Rel(WEB_F_AUTH, WEB_F_AUTH, $plain("setQueryData(['auth','me']); router.replace(safeNext(next, profile))"))
end

== Logout ==
Rel(WEB_F_AUTH, API_AUTH, $plain("POST /api/auth/logout (o browser junta o cookie refresh_token)"), "apiRequest; [AllowAnonymous]")
Rel(API_AUTH, CC_COOKIES, $plain("SessionService.EndAsync(refresh_token)"))
Rel(CC_COOKIES, C_DB, $plain("UPDATE refresh_tokens SET revoked_at = now WHERE id = … AND revoked_at IS NULL"), "ExecuteUpdate")
alt 0 linhas: o token já tinha sido usado
  Rel(CC_COOKIES, C_DB, $plain("Sinal de roubo: revoga todos os refresh tokens da conta"), "UPDATE refresh_tokens")
end
Rel(API_AUTH, CC_COOKIES, $plain("AuthCookies.Delete (os dois cookies)"))
Rel_Back(WEB_F_AUTH, API_AUTH, $plain("204, sempre (também com o access token expirado)"))
Rel(WEB_F_AUTH, WEB_F_AUTH, $plain("queryClient.clear(); router.replace('/login')"))

SHOW_LEGEND()
@enduml
