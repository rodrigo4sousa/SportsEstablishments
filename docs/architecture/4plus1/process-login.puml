' 4+1 process view - Login and logout (US03) · a single response for any failure; logout revokes the refresh token
' Version 1.1 - 2026-11-10
' For: whoever writes code and whoever debugs.
' Documented decision: A single response (401 invalid_credentials) for any login failure, and sessions in httpOnly cookies (ADR 0002).
' Not drawn: internal detail of the classes; refusals that do not change the sequence (they are in the text of process.md).
@startuml process-login
!include ../style.puml

title Process view - login and logout (US03): a single response for any failure; logout revokes the refresh token
autonumber

participant "Accounts" as WEB_F_AUTH
box "ASP.NET Core API"
  participant "Accounts and sessions" as API_AUTH
  participant "Login" as API_AUTH_LOGIN
  participant "Accounts in Identity" as API_AUTH_ACCOUNTS
  participant "Sessions and cookies" as CC_COOKIES
end box
database "PostgreSQL" as C_DB

== Login ==
WEB_F_AUTH -> API_AUTH : POST /api/auth/login { email, password } [apiJson;\n[AllowAnonymous], auth-login limit]
API_AUTH -> API_AUTH_LOGIN : LoginAsync(request)
API_AUTH_LOGIN -> API_AUTH_LOGIN : Validates empty fields (400 validation_failed)
API_AUTH_LOGIN -> API_AUTH_ACCOUNTS : AuthenticateAsync(email, password)
API_AUTH_ACCOUNTS -> C_DB : UserManager.FindByEmailAsync [SELECT users]
alt no account, deactivated or locked out
  API_AUTH_ACCOUNTS -> API_AUTH_ACCOUNTS : FallbackPasswordHash.Verify: the same PBKDF2 work, so timing\ndoes not give the case away
else wrong password
  API_AUTH_ACCOUNTS -> C_DB : AccessFailedAsync (5 in a row → 15 min lockout) [UPDATE\nusers]
else correct
  API_AUTH_ACCOUNTS -> C_DB : ResetAccessFailedCountAsync; the old hash is redone if it has\nfewer iterations [UPDATE users]
end
alt null
  API_AUTH --> WEB_F_AUTH : 401 invalid_credentials (the same for every failure)
else account
  API_AUTH_LOGIN -> CC_COOKIES : SessionService.StartAsync(userId, profile)
  CC_COOKIES -> C_DB : RefreshToken.Issue: 32 random bytes; stores only the SHA-256,\nexpires in 7 days [INSERT refresh_tokens]
  CC_COOKIES -> CC_COOKIES : HS256 JWT with sub and role, 15 min
  API_AUTH -> CC_COOKIES : AuthCookies.Append: access_token (Path=/, Lax) and refresh_token\n(Path=/api/auth, Strict)
  API_AUTH --> WEB_F_AUTH : 200 AccountResponse + Set-Cookie
  WEB_F_AUTH -> WEB_F_AUTH : setQueryData(['auth','me']); router.replace(safeNext(next,\nprofile))
end

== Logout ==
WEB_F_AUTH -> API_AUTH : POST /api/auth/logout (the browser adds the refresh_token cookie)\n[apiRequest; [AllowAnonymous]]
API_AUTH -> CC_COOKIES : SessionService.EndAsync(refresh_token)
CC_COOKIES -> C_DB : UPDATE refresh_tokens SET revoked_at = now WHERE id = … AND\nrevoked_at IS NULL [ExecuteUpdate]
alt 0 rows: the token had already been used
  CC_COOKIES -> C_DB : Theft signal: revokes all the account's refresh tokens [UPDATE\nrefresh_tokens]
end
API_AUTH -> CC_COOKIES : AuthCookies.Delete (both cookies)
API_AUTH --> WEB_F_AUTH : 204, always (also with an expired access token)
WEB_F_AUTH -> WEB_F_AUTH : queryClient.clear(); router.replace('/login')
@enduml
