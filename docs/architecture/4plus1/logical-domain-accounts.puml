' 4+1 logical view - Domain model · accounts, sessions, owner history and outbox
' Version 1.1 - 2026-11-10
' For: whoever writes the code.
' Documented decision: The account (AppUser), the refresh token and the owner history live in Infrastructure and the outbox message in Application; in Domain the account exists only as rules (Dom/Accounts).
' Not drawn: controllers, HTTP and screens; clubs, pitches and bookings are in logical-domain-booking.
@startuml logical-domain-accounts
!include ../style.puml
title Logical view - domain model: accounts, sessions, owner history and outbox

hide empty members

package "Domain" as L_DOM {
  class "Profiles" as D_POLICIES_Profiles {
    {static} Player = "Player"
    {static} Owner = "Owner"
    {static} Admin = "Admin"
    {static} SelfRegistration = [Player, Owner]
  }
  class "EmailAddressPolicy, AccountNamePolicy,\nPhoneNumberPolicy, PasswordPolicy,\nTermsAcceptancePolicy" as D_POLICIES {
    {static} PasswordPolicy.MinimumLength = 8
  }
  class "Booking" as D_BOOKING {
    Id : Guid
    PlayerId : Guid?
  }
}

package "Infrastructure" as L_INF {
  class "AppUser" as D_USER {
    Id : Guid
    Email, UserName : string
    Name : string
    PhoneNumber : string?
    PasswordHash, SecurityStamp
    RegisteredAt : DateTime (UTC)
    DeactivatedAt : DateTime?
    AcceptedTermsVersion : string?
    TermsAcceptedAt : DateTime?
    --
    IsActive : bool
    Deactivate(now)
    RecordTermsAcceptance(version, acceptedAt)
  }
  note top of D_USER : IdentityUser<Guid>

  class "RefreshToken" as D_REFRESH {
    Id : Guid
    UserId : Guid
    TokenHash : byte[] (SHA-256)
    CreatedAt, ExpiresAt : DateTime
    RevokedAt : DateTime?
    --
    {static} Issue(userId, now, expiresAt)
    {static} Hash(value)
    IsExpired(now)
  }

  class "OwnerStatusChange" as D_STATUSCHG {
    Id : Guid
    OwnerId : Guid
    Action : OwnerStatusAction
    Reason : string
    AdminId : Guid
    CreatedAt : DateTime
    --
    {static} Record(ownerId, action, reason, adminId, now)
  }
}

package "Application" as L_APP {
  enum "OwnerStatusAction" as D_STATUSCHG_OwnerStatusAction {
    Deactivated
    Reactivated
  }

  class "OutboxMessage" as D_OUTBOX {
    Id : Guid
    Type : string
    Payload : string (jsonb)
    CreatedAt : DateTime
    Attempts : int
    NextAttemptAt : DateTime
    SentAt, SkippedAt, FailedAt : DateTime?
    LastError : string?
    --
    {static} Create(type, payload, now, dueAt?)
    MarkSent(now)
    Skip(reason, now)
    RecordFailure(error, now, retry)
    GiveUp(error, now)
    IsPending : bool
  }

  class "OutboxRetry" as D_OUTBOX_OutboxRetry {
    FirstDelay, MaximumDelay : TimeSpan
    MaxAttempts : int
    --
    DelayAfter(failedAttempts)
  }
}

D_USER "1" --> "1" D_POLICIES_Profiles : user_roles (one profile)
D_USER ..> D_POLICIES : rules at registration and in the seed
D_REFRESH "0..*" --> "1" D_USER : UserId
D_STATUSCHG "0..*" --> "1" D_USER : OwnerId (RESTRICT)
D_STATUSCHG "0..*" --> "1" D_USER : AdminId (RESTRICT)
D_STATUSCHG ..> D_STATUSCHG_OwnerStatusAction
D_BOOKING "0..*" --> "0..1" D_USER : PlayerId
D_OUTBOX ..> D_OUTBOX_OutboxRetry : RecordFailure
D_OUTBOX ..> D_BOOKING : payload: bookingId (JSON, no FK)
D_OUTBOX ..> D_USER : payload: playerId / accountId (JSON, no FK)

@enduml
