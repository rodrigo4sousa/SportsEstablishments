' 4+1 development view - Development view · dependency injection composition
' Version 1.1 - 2026-11-10
' For: whoever is going to change the code.
' Documented decision: Each layer registers its own services and Program.cs only composes.
' Not drawn: classes, endpoints and business rules.
@startuml development-di
!include ../style.puml
title Development view - dependency injection composition

skinparam defaultTextAlignment left

rectangle "Program.cs\nWebApplication.CreateBuilder(args)\n(in the OpenAPI generator: in-memory placeholder settings)" as PROG
rectangle "AddApplication()\nvalidators (Singleton) and services (Scoped):\nOwnedClubs, BookingService, ClubBookingService, …" as ADDAPP
rectangle "AddInfrastructure(config)\nTimeProvider.System, AppDbContext, IAppDbContext,\nI*Store, IPitchLock, DemoDataSeeder, HealthChecks" as ADDINF
rectangle "AddAccounts · Identity, IAccountStore, admin seed,\nData Protection, PasswordHasherOptions" as ADDACC
rectangle "AddSessions · JwtOptions, ISessionService,\nPublicSiteOptions, IPasswordResetStore, AccountEmailBuilder" as ADDSES
rectangle "AddEmail · EmailOptions, OutboxOptions, IEmailSender,\nOutboxProcessor, OutboxDispatcher (HostedService)" as ADDMAIL
rectangle "The API's own extensions\nAddApiProblemDetails, AddOriginCheck, AddApiRateLimiting,\nAddCookieJwtAuthentication\n(AddControllers and AddOpenApi belong to the framework)" as ADDAPI
rectangle "Pipeline and startup\nUseForwardedHeaders, UseResponseSecurityHeaders,\nUseExceptionHandler, UseOriginCheck,\nUseRateLimiter, UseAuthentication, UseAuthorization;\nvalidates the options, migrates, admin seed, commands, MapControllers" as PIPE

PROG --> ADDAPP : 1st
PROG --> ADDINF : 2nd
ADDINF --> ADDACC
ADDINF --> ADDSES
ADDINF --> ADDMAIL
PROG --> ADDAPI : 3rd
PROG --> PIPE : app.Build()

@enduml
