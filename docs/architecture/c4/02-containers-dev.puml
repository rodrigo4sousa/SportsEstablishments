' C4 level 2 - Containers · development (docker compose)
' Version 1.1 - 2026-11-10
' Not drawn: classes, folders and internal components; C-CLI (seed-demo, set-admin-password) is the same executable as the API and has no box.
@startuml 02-containers-dev
!include <C4/C4_Container>
!include ../style.puml

title Containers - development (docker compose)

LAYOUT_LEFT_RIGHT()

Container_Ext(C_BROWSER, "User's browser", "Browser")

System_Boundary(COMPOSE, "docker compose (name: sportsbooking)") {
  Container(C_WEB, "Next.js application", "Next.js 16, Node.js, port 3000")
  Container_Boundary(B_API, "API process (port 8080; 5080 on the host)") {
    Container(C_API, "ASP.NET Core API", ".NET 10, controllers")
    Container(C_WORKER, "Email worker", "BackgroundService")
  }
  ContainerDb(C_DB, "Database", "PostgreSQL 18.6, port 5432")
}

System_Ext(X_MAILPIT, "Mailpit")

Rel(C_BROWSER, C_WEB, $plain("Opens pages and calls /api/*"), "HTTP, port 3000, cookies")
Rel(C_WEB, C_API, $plain("Forwards /api/* and reads the API in Server Components"), "HTTP, api:8080")
Rel(C_BROWSER, C_API, $plain("Swagger and direct calls (tools)"), "HTTP, port 5080")
Rel(C_API, C_DB, $plain("Reads and writes"), "SQL, Npgsql")
Rel(C_WORKER, C_DB, $plain("Reads the outbox and records the result"), "SQL")
Rel(C_WORKER, X_MAILPIT, $plain("Sends the email"), "SMTP, port 1025")
@enduml
