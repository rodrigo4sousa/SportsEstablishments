' C4 nível 2 - Contentores · desenvolvimento (docker compose)
' Version 1.1 - 2026-11-10
' Não desenhado: classes, pastas e componentes internos; o C-CLI (seed-demo, set-admin-password) é o mesmo executável da API e não tem caixa.
@startuml 02-containers-dev
!include <C4/C4_Container>
!include ../style.puml

title Contentores - desenvolvimento (docker compose)

LAYOUT_LEFT_RIGHT()

Container_Ext(C_BROWSER, "Browser do utilizador", "Browser")

System_Boundary(COMPOSE, "docker compose (nome: sportsbooking)") {
  Container(C_WEB, "Aplicação Next.js", "Next.js 16, Node.js, porta 3000")
  Container_Boundary(B_API, "Processo da API (porta 8080; 5080 no anfitrião)") {
    Container(C_API, "API ASP.NET Core", ".NET 10, controllers")
    Container(C_WORKER, "Worker de emails", "BackgroundService")
  }
  ContainerDb(C_DB, "Base de dados", "PostgreSQL 18.6, porta 5432")
}

System_Ext(X_MAILPIT, "Mailpit")

Rel(C_BROWSER, C_WEB, $plain("Abre páginas e chama /api/*"), "HTTP, porta 3000, cookies")
Rel(C_WEB, C_API, $plain("Reencaminha /api/* e lê a API nos Server Components"), "HTTP, api:8080")
Rel(C_BROWSER, C_API, $plain("Swagger e chamadas diretas (ferramentas)"), "HTTP, porta 5080")
Rel(C_API, C_DB, $plain("Lê e escreve"), "SQL, Npgsql")
Rel(C_WORKER, C_DB, $plain("Lê o outbox e marca o resultado"), "SQL")
Rel(C_WORKER, X_MAILPIT, $plain("Envia o email"), "SMTP, porta 1025")
@enduml
