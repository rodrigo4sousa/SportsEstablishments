' C4 level 3 - API components · overview by feature
' Version 1.1 - 2026-11-10
' Not drawn: individual classes; the startup and command-line components (API-ADMINSEED, API-DEMO, API-ADMINPW) appear only in the accounts diagram.
@startuml 03-components-api-overview
!include <C4/C4_Component>
!include ../style.puml

title API components - overview by feature

LAYOUT_TOP_DOWN()

Container(C_WEB, "Next.js application", "Next.js 16")

Container_Boundary(C_API, "ASP.NET Core API") {
  Component(API_AUTH, "Accounts and sessions", "AuthController, App/Accounts, App/Auth, Inf/Identity, Inf/Auth")
  Component(API_CATALOG, "Public catalogue", "ClubsController, LocalitiesController, App/Catalog")
  Component(API_BOOK, "Player bookings", "BookingsController, MeBookingsController")
  Component(API_CLUBS, "Owner's clubs", "ManageClubsController, ClubService")
  Component(API_PITCHES, "Pitches", "ManagePitchesController, PitchService, OwnedPitches")
  Component(API_SCHED, "Schedules", "ManagePitchScheduleController, PitchScheduleService")
  Component(API_BLOCKS, "Blocks", "ManageBlocksController, BlockService")
  Component(API_PRICE, "Price bands", "ManagePriceBandsController, PriceBandService")
  Component(API_CLUBBOOK, "Owner's calendar and bookings", "ManageCalendarController, ManageBookingsController")
  Component(API_STATS, "Owner's statistics", "ManageStatisticsController, OccupationService")
  Component(API_ADMIN, "Administration", "AdminController, App/Admin, Inf/Admin")
  Component(API_NOTIF, "Notifications (outbox)", "App/Notifications, Inf/Notifications")
  Component(CC_DAYCAL, "A day's slots and «free»", "PitchDayCalendar, DaySlot")
  Component(API_PERSIST, "Persistence", "IAppDbContext, AppDbContext")
}

ContainerDb(C_DB, "PostgreSQL", "PostgreSQL 18.6")

Rel(C_WEB, API_CATALOG, $plain("Searches and reads clubs"), "HTTP, JSON")
Rel(C_WEB, API_BOOK, $plain("Books and cancels"), "HTTP, JSON, cookies")
Rel(C_WEB, API_AUTH, $plain("Signs in, signs out, renews the session"), "HTTP, JSON, cookies")

Rel(API_BOOK, API_CATALOG, $plain("Finds the pitch among the visible clubs (series preview)"), "VisibleClubs")
Rel(API_BOOK, API_AUTH, $plain("Checks that the owner is active"), "IAccountStore.IsActiveAsync")
Rel(API_CLUBBOOK, API_AUTH, $plain("Checks that the owner is active"), "IAccountStore.IsActiveAsync")
Rel(API_CLUBBOOK, API_PITCHES, $plain("Finds the club's pitch"), "OwnedPitches")
Rel(API_SCHED, API_PITCHES, $plain("Finds the club's pitch"), "OwnedPitches")
Rel(API_BLOCKS, API_PITCHES, $plain("Finds the club's pitch"), "OwnedPitches")
Rel(API_PRICE, API_PITCHES, $plain("Finds the club's pitch"), "OwnedPitches")
Rel(API_SCHED, CC_DAYCAL, $plain("Asks for the day's slots"), "SlotsAsync")
Rel(API_CATALOG, CC_DAYCAL, $plain("Asks for the day's slots"), "SlotsAsync")
Rel(API_ADMIN, API_STATS, $plain("Uses the same occupation calculation"), "OccupationService")
Rel(API_BOOK, API_NOTIF, $plain("Puts the booking emails in the outbox"), "BookingEmailOutbox")
Rel(API_CLUBBOOK, API_NOTIF, $plain("Puts the cancellation email in the outbox"), "BookingEmailOutbox")
Rel(API_AUTH, API_NOTIF, $plain("Puts the account emails in the outbox"), "OutboxMessage")
Rel(API_PERSIST, C_DB, $plain("Reads and writes"), "SQL, Npgsql")

note right of API_PERSIST
  Every component reads and writes
  through Persistence (IAppDbContext)
  or an Infrastructure store.
  Bookings, blocks, cancellations, no-shows,
  price bands and pitch deactivation
  go through the pitch lock.
  The worker sends what
  Notifications put in the outbox.
end note
@enduml
