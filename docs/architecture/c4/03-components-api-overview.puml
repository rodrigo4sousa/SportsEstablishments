' C4 nível 3 - Componentes da API · visão geral por funcionalidade
' Version 1.1 - 2026-11-10
' Não desenhado: classes individuais; os componentes de arranque e de linha de comandos (API-ADMINSEED, API-DEMO, API-ADMINPW) estão só no diagrama de contas.
@startuml 03-components-api-overview
!include <C4/C4_Component>
!include ../style.puml

title Componentes da API - visão geral por funcionalidade

LAYOUT_TOP_DOWN()

Container(C_WEB, "Aplicação Next.js", "Next.js 16")

Container_Boundary(C_API, "API ASP.NET Core") {
  Component(API_AUTH, "Contas e sessões", "AuthController, App/Accounts, App/Auth, Inf/Identity, Inf/Auth")
  Component(API_CATALOG, "Catálogo público", "ClubsController, LocalitiesController, App/Catalog")
  Component(API_BOOK, "Reservas do jogador", "BookingsController, MeBookingsController")
  Component(API_CLUBS, "Clubes do dono", "ManageClubsController, ClubService")
  Component(API_PITCHES, "Campos", "ManagePitchesController, PitchService, OwnedPitches")
  Component(API_SCHED, "Horários", "ManagePitchScheduleController, PitchScheduleService")
  Component(API_BLOCKS, "Bloqueios", "ManageBlocksController, BlockService")
  Component(API_PRICE, "Faixas de preço", "ManagePriceBandsController, PriceBandService")
  Component(API_CLUBBOOK, "Calendário e reservas do dono", "ManageCalendarController, ManageBookingsController")
  Component(API_STATS, "Estatísticas do dono", "ManageStatisticsController, OccupationService")
  Component(API_ADMIN, "Administração", "AdminController, App/Admin, Inf/Admin")
  Component(API_NOTIF, "Notificações (outbox)", "App/Notifications, Inf/Notifications")
  Component(CC_DAYCAL, "Slots de um dia e «livre»", "PitchDayCalendar, DaySlot")
  Component(API_PERSIST, "Persistência", "IAppDbContext, AppDbContext")
}

ContainerDb(C_DB, "PostgreSQL", "PostgreSQL 18.6")

Rel(C_WEB, API_CATALOG, $plain("Pesquisa e lê clubes"), "HTTP, JSON")
Rel(C_WEB, API_BOOK, $plain("Reserva e cancela"), "HTTP, JSON, cookies")
Rel(C_WEB, API_AUTH, $plain("Entra, sai, renova a sessão"), "HTTP, JSON, cookies")

Rel(API_BOOK, API_CATALOG, $plain("Encontra o campo nos clubes visíveis (pré-visualização da série)"), "VisibleClubs")
Rel(API_BOOK, API_AUTH, $plain("Confirma que o dono está ativo"), "IAccountStore.IsActiveAsync")
Rel(API_CLUBBOOK, API_AUTH, $plain("Confirma que o dono está ativo"), "IAccountStore.IsActiveAsync")
Rel(API_CLUBBOOK, API_PITCHES, $plain("Encontra o campo do clube"), "OwnedPitches")
Rel(API_SCHED, API_PITCHES, $plain("Encontra o campo do clube"), "OwnedPitches")
Rel(API_BLOCKS, API_PITCHES, $plain("Encontra o campo do clube"), "OwnedPitches")
Rel(API_PRICE, API_PITCHES, $plain("Encontra o campo do clube"), "OwnedPitches")
Rel(API_SCHED, CC_DAYCAL, $plain("Pede os slots do dia"), "SlotsAsync")
Rel(API_CATALOG, CC_DAYCAL, $plain("Pede os slots do dia"), "SlotsAsync")
Rel(API_ADMIN, API_STATS, $plain("Usa o mesmo cálculo de ocupação"), "OccupationService")
Rel(API_BOOK, API_NOTIF, $plain("Põe os emails da reserva no outbox"), "BookingEmailOutbox")
Rel(API_CLUBBOOK, API_NOTIF, $plain("Põe o email do cancelamento no outbox"), "BookingEmailOutbox")
Rel(API_AUTH, API_NOTIF, $plain("Põe os emails de conta no outbox"), "OutboxMessage")
Rel(API_PERSIST, C_DB, $plain("Lê e escreve"), "SQL, Npgsql")

note right of API_PERSIST
  Todos os componentes leem e escrevem
  através da Persistência (IAppDbContext)
  ou de uma store da Infrastructure.
  Reservas, bloqueios, cancelamentos, faltas,
  faixas de preço e desativação de campos
  passam pelo trinco do campo.
  O worker envia o que
  as Notificações puseram no outbox.
end note
@enduml
