' C4 nível 3 - Componentes do front end · áreas e funcionalidades
' Version 1.1 - 2026-11-10
' Não desenhado: classes individuais, salvo quando são o próprio componente.
@startuml 03-components-web-features
!include <C4/C4_Component>
!include ../style.puml

title Componentes do front end - áreas e funcionalidades

LAYOUT_TOP_DOWN()

Container_Boundary(C_WEB, "Aplicação Next.js") {
  Component(WEB_AREA_PLAYER, "Área do jogador", "app/(player)")
  Component(WEB_AREA_ACCOUNT, "Páginas de conta", "app/login, register, …")
  Component(WEB_AREA_MANAGE, "Área do dono", "app/manage")
  Component(WEB_AREA_ADMIN, "Área do admin", "app/admin")

  Component(WEB_F_AUTH, "Contas", "features/auth")
  Component(WEB_F_CATALOG, "Catálogo", "features/catalog")
  Component(WEB_F_BOOKING, "Reservar", "features/booking")
  Component(WEB_F_MYBOOK, "As minhas reservas", "features/my-bookings")
  Component(WEB_F_CLUBS, "Clubes do dono", "features/clubs")
  Component(WEB_F_PITCHES, "Campos", "features/pitches")
  Component(WEB_F_CALENDAR, "Calendário", "features/calendar")
  Component(WEB_F_STATS, "Estatísticas", "features/statistics")
  Component(WEB_F_ADMIN, "Admin", "features/admin")
}

Rel(WEB_AREA_PLAYER, WEB_F_CATALOG, $plain("Pesquisa e página do clube"), "")
Rel(WEB_AREA_PLAYER, WEB_F_BOOKING, $plain("Reserva na página do clube"), "ClubBooking")
Rel(WEB_AREA_PLAYER, WEB_F_MYBOOK, $plain("/bookings"), "MyBookings")
Rel(WEB_AREA_PLAYER, WEB_F_AUTH, $plain("Estado da sessão no cabeçalho"), "AccountStatus")
Rel(WEB_AREA_ACCOUNT, WEB_F_AUTH, $plain("Formulários de conta"), "")
Rel(WEB_AREA_MANAGE, WEB_F_CLUBS, $plain("Clubes"), "ClubList, EditClub")
Rel(WEB_AREA_MANAGE, WEB_F_CALENDAR, $plain("Calendário"), "ClubCalendar")
Rel(WEB_AREA_MANAGE, WEB_F_STATS, $plain("Estatísticas"), "")
Rel(WEB_AREA_ADMIN, WEB_F_ADMIN, $plain("Painel e página do dono"), "")

Rel(WEB_F_CLUBS, WEB_F_PITCHES, $plain("Mostra os campos do clube"), "PitchSection")
Rel(WEB_F_CALENDAR, WEB_F_PITCHES, $plain("Lê os slots livres para a nova reserva"), "fetchSlots")
Rel(WEB_F_BOOKING, WEB_F_CATALOG, $plain("Lê os slots públicos do campo"), "fetchPublicSlots")
Rel(WEB_F_BOOKING, WEB_F_AUTH, $plain("Sabe se quem reserva é jogador"), "useCurrentUser")
Rel(WEB_F_BOOKING, WEB_F_MYBOOK, $plain("Invalida as minhas reservas"), "myBookingsQueryKey")
Rel(WEB_F_MYBOOK, WEB_F_CATALOG, $plain("Invalida o catálogo ao cancelar"), "catalogQueryKey")
Rel(WEB_F_ADMIN, WEB_F_STATS, $plain("Formata horas e ocupação"), "formatHours, formatOccupation")
Rel(WEB_F_STATS, WEB_F_CLUBS, $plain("Clube não encontrado"), "ClubNotFound")

note bottom of WEB_F_PITCHES
  Campos também dá a quase todas as funcionalidades
  formatPrice, sportLabel e previewDateRange (setas omitidas).
  Todas as funcionalidades chamam a API só pelo Cliente da API
  e mostram datas só por lib/datetime.ts.
end note
@enduml
