' C4 nível 3 - Componentes da API · notificações: outbox e worker de emails
' Version 1.1 - 2026-11-10
' Não desenhado: classes individuais, salvo quando são o próprio componente.
@startuml 03-components-api-notifications
!include <C4/C4_Component>
!include ../style.puml

title Componentes da API - notificações: outbox e worker de emails

LAYOUT_TOP_DOWN()

Container_Boundary(C_API, "API ASP.NET Core (pedidos)") {
  Component(API_BOOK, "Reservas do jogador", "BookingService, RecurringBookingService, BookingCancellationService")
  Component(API_CLUBBOOK, "Reservas do dono", "ClubBookingService.CancelAsync")
  Component(API_AUTH_RESET, "Recuperação", "PasswordResetStore, AccountEmailBuilder")
  Component(API_NOTIF_OUTBOX, "Pôr no outbox", "BookingEmailOutbox, OutboxMessage.Create")
}

Container_Boundary(C_WORKER, "Worker de emails (BackgroundService no processo da API)") {
  Component(API_NOTIF_DISPATCH, "Ciclo do worker", "OutboxDispatcher")
  Component(API_NOTIF_PROC, "Processar o que está devido", "OutboxProcessor.ProcessDueAsync")
  Component(API_NOTIF_COMPOSE, "Compor os emails", "BookingEmailComposer, BookingSeriesEmailComposer, BookingNotificationComposer, AccountEmailComposer")
  Component(API_NOTIF_SENDER, "Enviar", "IEmailSender, SmtpEmailSender (MailKit)")
}

Component(CC_DATAPROT, "Data Protection", "Identity")
Component(CC_TIME, "Relógio injetado", "TimeProvider")

Container_Boundary(C_DB, "PostgreSQL") {
  ComponentDb(DB_OUTBOX, "outbox_messages", "Tabela")
  ComponentDb(DB_OUTBOXUQ, "ux_outbox_messages_booking_notification", "Índice único parcial")
  ComponentDb(DB_USERS, "users", "Tabela")
  ComponentDb(DB_BOOKINGS, "bookings", "Tabela")
}

System_Ext(X_SMTP, "Servidor SMTP")

Rel(API_BOOK, API_NOTIF_OUTBOX, $plain("Confirmação, aviso ao dono, lembrete, resumo da série, cancelamento"), "mesma transação do trinco")
Rel(API_CLUBBOOK, API_NOTIF_OUTBOX, $plain("Cancelamento pelo clube, com o motivo"), "mesma transação do trinco")
Rel(API_AUTH_RESET, DB_OUTBOX, $plain("password_reset (só o id da conta), password_changed"), "INSERT na própria transação")
Rel(API_NOTIF_OUTBOX, DB_OUTBOX, $plain("Escrita pelo SaveChanges de quem chama"), "INSERT")
Rel(DB_OUTBOX, DB_OUTBOXUQ, $plain("Verificado em cada INSERT"), "")

Rel(API_NOTIF_DISPATCH, CC_TIME, $plain("Espera o intervalo"), "Task.Delay(…, timeProvider)")
Rel(API_NOTIF_DISPATCH, API_NOTIF_PROC, $plain("Corre uma passagem (assíncrono)"), "ProcessDueAsync")
Rel(API_NOTIF_PROC, DB_OUTBOX, $plain("Reclama as devidas e grava o resultado"), "FOR UPDATE SKIP LOCKED")
Rel(API_NOTIF_PROC, DB_BOOKINGS, $plain("Lê a reserva no momento do envio"), "SQL")
Rel(API_NOTIF_PROC, DB_USERS, $plain("Lê o destinatário no momento do envio"), "SQL")
Rel(API_NOTIF_PROC, API_NOTIF_COMPOSE, $plain("Compõe o email de reserva"), "")
Rel(API_NOTIF_PROC, API_AUTH_RESET, $plain("Compõe o email de conta"), "AccountEmailBuilder.BuildAsync")
Rel(API_AUTH_RESET, CC_DATAPROT, $plain("Faz o token"), "GeneratePasswordResetTokenAsync")
Rel(API_AUTH_RESET, API_NOTIF_COMPOSE, $plain("Escreve o texto com o link"), "AccountEmailComposer")
Rel(API_NOTIF_PROC, API_NOTIF_SENDER, $plain("Envia"), "SendAsync")
Rel(API_NOTIF_SENDER, X_SMTP, $plain("Envia o email"), "SMTP")
@enduml
