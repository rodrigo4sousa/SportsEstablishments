' C4 nível 2 - Contentores · produção (T06)
' Version 1.0 - 2026-11-09
' Não desenhado: classes, pastas e componentes internos; o C-CLI (seed-demo, set-admin-password) é o mesmo executável da API e não tem caixa.
@startuml 02-containers-prod
!include <C4/C4_Container>
!include ../style.puml

title Contentores · produção (T06)

LAYOUT_TOP_DOWN()

Container_Ext(C_BROWSER, "C-BROWSER · Browser do utilizador", "Browser", "Só fala com a origem da Vercel; guarda os cookies httpOnly de sessão.")

Boundary(PL_VERCEL, "PL-VERCEL · Vercel") {
  Container(C_WEB, "C-WEB · Aplicação Next.js", "Next.js 16", "Páginas com HTTPS; o rewrite de /api/* envia para a API.")
}

Boundary(PL_RENDER, "PL-RENDER · Render") {
  Boundary(PL_RENDER_API, "PL-RENDER-API · Serviço web público") {
    Container(C_API, "C-API · API ASP.NET Core", ".NET 10, controllers", "Regras de negócio, cookies, base de dados.")
    Container(C_WORKER, "C-WORKER · Worker de emails", "BackgroundService", "Envia os emails do outbox enquanto a API estiver acordada.")
  }
}

Boundary(PL_SUPABASE, "PL-SUPABASE · Supabase") {
  ContainerDb(C_DB, "C-DB · Base de dados", "PostgreSQL gerido", "Todos os dados e as chaves do Data Protection.")
}

System_Ext(PL_BREVO, "PL-BREVO · Brevo", "Servidor SMTP de produção")

Rel(C_BROWSER, C_WEB, $plain("Abre páginas e chama /api/*"), "HTTPS, cookies")
Rel(C_WEB, C_API, $plain("Reescreve /api/* e lê a API nos Server Components"), "HTTPS, Internet")
Rel(C_API, C_DB, $plain("Lê e escreve"), "SQL, Npgsql, modo sessão")
Rel(C_WORKER, C_DB, $plain("Lê o outbox e marca o resultado"), "SQL")
Rel(C_WORKER, PL_BREVO, $plain("Envia o email"), "SMTP, StartTls")

SHOW_LEGEND()
@enduml
