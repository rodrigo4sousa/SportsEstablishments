' C4 nível 3 - Componentes da API · reservas (uma, série semanal, do dono) e verificação partilhada do slot
' Version 1.0 - 2026-11-09
' Não desenhado: classes individuais, salvo quando são o próprio componente.
@startuml 03-components-api-bookings
!include <C4/C4_Component>
!include ../style.puml

title Componentes da API · reservas (uma, série semanal, do dono) e verificação partilhada do slot

LAYOUT_TOP_DOWN()

Container_Boundary(C_API, "C-API · API ASP.NET Core") {
  Boundary(API_BOOK, "API-BOOK · Reservas do jogador (BookingsController, MeBookingsController; política Player)") {
    Component(API_BOOK_SINGLE, "API-BOOK-SINGLE · Uma reserva", "BookingService.CreateAsync", "Valida, encontra o campo, confirma o dono ativo, tranca o campo, verifica o slot, preço de PriceForSlot, insere.")
    Component(API_BOOK_SERIES, "API-BOOK-SERIES · Série semanal", "RecurringBookingService, RecurringOccurrences", "Pré-visualização e criação: cada data em BookOneAsync, com o seu trinco e a sua transação.")
    Component(API_BOOK_MINE, "API-BOOK-MINE · As minhas reservas e cancelar", "MyBookingsService, BookingCancellationService", "Lista e detalhe filtrados pelo jogador da sessão; cancelar com Booking.CancelByPlayer.")
    Component(API_BOOK_STORE, "API-BOOK-STORE · Store das reservas", "IBookingStore, Inf/Bookings/BookingStore", "TryAddAsync e TrySaveChangesAsync: 23P01 → false (409 slot_taken).")
  }
  Component(API_CLUBBOOK, "API-CLUBBOOK · Reservas do dono", "ClubBookingService, ClubCalendarService", "Reserva para cliente, cancelar com motivo, marcar e anular falta, calendário.")
  Component(CC_AUTHZ, "CC-AUTHZ · Autorização por dono", "OwnedClubs, OwnedPitches, OwnedBookings", "Só os clubes, campos e reservas do dono da sessão (404 igual para o de outro dono).")
  Component(CC_SLOTCHECK, "CC-SLOTCHECK · Verificação do slot", "BookingSlotCheck.CheckAsync", "Campo ativo → janela → grelha (SlotStartingAt) → começado → bloqueios. Não olha para outras reservas.")
  Component(CC_LOCK, "CC-LOCK · Trinco do campo", "IPitchLock, Inf/Pitches/PitchLock", "Transação + SELECT … FOR UPDATE na linha do campo.")
  Component(API_CATALOG, "API-CATALOG · Clubes visíveis", "VisibleClubs", "Dono ativo e pelo menos um campo ativo.")
  Component(API_AUTH, "API-AUTH · Contas", "IAccountStore.IsActiveAsync", "O dono do clube não está desativado.")
  Component(API_NOTIF, "API-NOTIF · Outbox", "BookingEmailOutbox", "Junta as mensagens ao mesmo IAppDbContext, antes do SaveChanges de quem chama.")
}

Container_Boundary(C_DB, "C-DB · PostgreSQL") {
  ComponentDb(DB_PITCHES, "DB-PITCHES · pitches", "Tabela", "A linha trancada pelo CC-LOCK.")
  ComponentDb(DB_BLOCKS, "DB-BLOCKS · blocks", "Tabela", "Bloqueios do campo.")
  ComponentDb(DB_BOOKINGS, "DB-BOOKINGS · bookings", "Tabela", "Reservas; nunca apagadas.")
  ComponentDb(DB_NOOVERLAP, "DB-NOOVERLAP · bookings_no_overlap", "Exclusion constraint (GiST)", "Nenhuma reserva Confirmed se sobrepõe no mesmo campo.")
  ComponentDb(DB_OUTBOX, "DB-OUTBOX · outbox_messages", "Tabela", "Emails por enviar.")
}

Rel(API_BOOK_SINGLE, API_AUTH, $plain("Confirma que o dono está ativo (422 club_unavailable)"), "")
Rel(API_BOOK_SINGLE, CC_LOCK, $plain("Tranca o campo"), "LockAsync")
Rel(API_BOOK_SINGLE, CC_SLOTCHECK, $plain("Verifica o slot no campo lido dentro do trinco"), "CheckAsync")
Rel(API_BOOK_SINGLE, API_NOTIF, $plain("Confirmação, aviso ao dono e lembrete"), "Enqueue*")
Rel(API_BOOK_SINGLE, API_BOOK_STORE, $plain("Insere"), "TryAddAsync")

Rel(API_BOOK_SERIES, API_CATALOG, $plain("Pré-visualização: só um campo ativo de um clube visível"), "")
Rel(API_BOOK_SERIES, API_AUTH, $plain("Confirma que o dono está ativo"), "")
Rel(API_BOOK_SERIES, CC_LOCK, $plain("Tranca o campo, uma vez por data"), "LockAsync")
Rel(API_BOOK_SERIES, CC_SLOTCHECK, $plain("Verifica cada data"), "CheckAsync")
Rel(API_BOOK_SERIES, API_NOTIF, $plain("Aviso ao dono e lembrete por reserva; um resumo da série"), "EnqueueSeriesSummaryAsync")
Rel(API_BOOK_SERIES, API_BOOK_STORE, $plain("Insere cada data (23P01 → taken)"), "TryAddAsync")

Rel(API_BOOK_MINE, CC_LOCK, $plain("Cancelar: tranca e volta a ler a reserva"), "LockAsync")
Rel(API_BOOK_MINE, API_NOTIF, $plain("Email do cancelamento"), "EnqueuePlayerCancellationAsync")
Rel(API_BOOK_MINE, DB_BOOKINGS, $plain("Lê as do jogador; grava o cancelamento"), "SQL")

Rel(API_CLUBBOOK, CC_AUTHZ, $plain("Chega ao clube, ao campo e à reserva"), "OwnedPitches, OwnedBookings")
Rel(API_CLUBBOOK, API_AUTH, $plain("Reserva para cliente: dono ativo"), "")
Rel(API_CLUBBOOK, CC_LOCK, $plain("Tranca o campo (criar, cancelar, faltas)"), "LockAsync")
Rel(API_CLUBBOOK, CC_SLOTCHECK, $plain("Reserva para cliente: as mesmas regras"), "CheckAsync")
Rel(API_CLUBBOOK, API_BOOK_STORE, $plain("Insere; anula a falta"), "TryAddAsync, TrySaveChangesAsync")
Rel(API_CLUBBOOK, API_NOTIF, $plain("Email do cancelamento pelo clube"), "EnqueueClubCancellationAsync")
Rel(API_CLUBBOOK, DB_BOOKINGS, $plain("Lê o calendário; grava o cancelamento e a falta"), "SQL")

Rel(CC_LOCK, DB_PITCHES, $plain("Tranca a linha"), "SELECT … FOR UPDATE")
Rel(CC_SLOTCHECK, DB_BLOCKS, $plain("Procura bloqueios sobrepostos"), "SQL")
Rel(API_BOOK_STORE, DB_BOOKINGS, $plain("Escreve"), "INSERT, UPDATE")
Rel(DB_BOOKINGS, DB_NOOVERLAP, $plain("Cada escrita é verificada"), "23P01")
Rel(API_NOTIF, DB_OUTBOX, $plain("Escreve no mesmo SaveChanges"), "INSERT")

SHOW_LEGEND()
@enduml
