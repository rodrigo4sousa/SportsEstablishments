# Copy to .env for docker compose. Local development values only; never commit real secrets.
POSTGRES_DB=sportsbooking
POSTGRES_USER=sportsbooking
POSTGRES_PASSWORD=sportsbooking

# Admin account seeded on API startup (US04). Leave empty to run without an admin.
# The password needs at least 8 characters. Use your own values in .env only.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
