<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- dotnet user-secrets for local development values (e.g. AdminSeed:Password). -->
    <UserSecretsId>5f0a3c8e-2b1d-4d7e-9a64-3e8c1f2b7d90</UserSecretsId>
    <!-- Build-time OpenAPI document, consumed by the frontend (npm run gen:api). -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name sportsbooking-api</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SportsBooking.Infrastructure\SportsBooking.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SportsBooking.UnitTests" />
  </ItemGroup>

</Project>
