        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "OwnerClubResponse": {
        "required": [
          "id",
          "slug",
          "name",
          "address",
          "locality",
          "phone",
          "contactEmail",
          "cancellationWindowHours",
          "timeZone"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
