  "components": {
    "schemas": {
      "AccountResponse": {
        "required": [
          "id",
          "name",
          "email",
          "profile"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          }
        }
      },
      "ClubRequest": {
        "required": [
          "name",
          "address",
          "locality",
          "phone",
          "contactEmail"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "locality": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "contactEmail": {
            "type": "string"
          },
          "cancellationWindowHours": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "DayHours": {
        "required": [
          "closed",
          "opens",
          "closes"
        ],
        "type": "object",
        "properties": {
          "closed": {
            "type": "boolean"
          },
          "opens": {
            "type": [
              "null",
              "string"
            ]
          },
          "closes": {
            "type": [
